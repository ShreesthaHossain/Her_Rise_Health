DATABASE_URL=sqlite:///./herrise.db
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_ENV=local
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Legacy shared secret only. Leave empty when SUPABASE_JWKS_URL is set.
SUPABASE_JWT_SECRET=
# Server only. Never expose this to the browser or a NEXT_PUBLIC variable.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection for profiles. Leave empty until the Supabase migration has been applied.
# Local API tests use their own SQLite file. Do not point this at the Vite app database.
ACCOUNT_DATABASE_URL=
